# Generated by Cargo
/debug
target

# Backup files generated by rustfmt
**/*.rs.bk

# Debugging information from MSVC Windows builds of rustc
*.pdb

# Mutation testing data from cargo mutants
**/mutants.out*/

# RustRover
.idea/
.run/**.xml

# Python
venv/
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Card scans, generated exports, and dry-run transcripts. Card images are never
# committed; they live in the source archive.
*.pdf
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.psd
*.csv
*.pnx
*.zip
*.log
dump*.sql

# ML model weights. Fetched from upstream, not vendored.
*.onnx
*.pth

# Image file renamer caches. See utils/image_file_renamers/README.md.
utils/image_file_renamers/**/*_cache.json

# Re-include the asset dirs. build.rs compiles the .onnx into the upscaler, and each
# game adapter's backs/ folder holds the card backs that ship with the app.
!proxynexus-core/assets/**
!proxynexus-core/src/games/*/backs/**
!proxynexus-gui/assets/**

# Build outputs
proxynexus-gui/public/card_backs/
*.bpk